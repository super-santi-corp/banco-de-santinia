<!DOCTYPE html>
<html lang="es">
    <head>
        <title>Inicia sesión en el Banco de Santinia</title>
        <meta name="description" content="Iniciar sesión - Banco de Santinia" />
        <link rel="stylesheet" href="/stil.css" />
    </head>
    <body>
        <h1>Iniciar sesión</h1>

        <% if (error) { %>
            <span style="color: red"><%= error.message %> (<%= error.code %>)</span>
        <% } %>

        <form action="/es/inic-ses" method="post">
            <label for="username">Número de cuenta: </label>
            <input type="text" id="username" name="uzantnomo" required />

            <br />

            <label for="password">Token: </label>
            <input type="password" id="password" name="tokeno" required />
            
            <br /><br />
            
            <button type="submit">Iniciar sesión</button>
        </form>
    </body>
</html>
