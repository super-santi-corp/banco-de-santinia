<!DOCTYPE html>
<html lang="eo">
	<head>
		<title>Saldo kaj transakcioj</title>
        <meta name="description" content="Banko de Santinio: la centra banko de Santiniunio." />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="stylesheet" href="/stil.css" />
	</head>
	<body>
		<h1>Saldo kaj transakcioj</h1>
		<main>
			<p>Via saldo estas: <strong><%= balance %></strong></p>
			<details>
				<summary>Transakcia historio (<%= transactions.length %>)</summary>
				<ul>
					<% transactions.forEach((tx) => { %>
						<li class="tx-detaloj">
							<strong><%= tx.sourceAccount %></strong> &rarr; <strong><%= tx.destinationAccount %></strong> <br />
							<strong>Kvanto: </strong>
							<span class="tx-kvanto <% if (tx.amount.startsWith('-')) { %>malpli-ol-nul<% } else {%>pli-ol-nul<% } %>">
								<%= tx.amount %>
							</span>
							<br />
							<strong>Dato kaj tempo (GMT -5): </strong>
							<%= esperantoDate(new Date(tx.datetime), TIME_SHIFT) %><br />
							<strong>Kialo: </strong>
							<%= tx.purpose %><br />
							<strong>Transakcia identigilo: </strong>
							<code><%= tx.txId %></code>
						</li>
					<% }); %>
				</ul>
			</details>
		</main>
	</body>
</html>