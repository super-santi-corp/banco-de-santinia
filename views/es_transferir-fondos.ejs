<!DOCTYPE html>
<html lang="es">
	<head>
		<title>Transferir fondos - Banco de Santinia</title>
		<meta name="description" content="Transferir fondos - Banco de Santinia" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="stylesheet" href="/stil.css" />
	</head>
	<body>
		<h1>Transferir fondos</h1>
		<main>
			<form action="/es/transferir-fondos" method="post">
				<input type="hidden" name="idem" value="<%= idempotencyNonce %>" />
				<label for="payee">Número de cuenta destino: </label>
				<input
					type="text"
					id="payee"
					name="ricevanto"
					maxlength="18"
					placeholder="18 dígitos, sin guiones"
					required
				/>
				<br />
				<label for="amount">Monto: </label>
				<input
					type="number"
					id="amount"
					name="kvanto"
					min="0"
					step="0.01"
					placeholder="Monto a transferir (se redondea a dos dígitos decimales)"
					required
				/>
				<br />
				<label for="purpose">Por concepto de: </label>
				<input
					type="text"
					id="purpose"
					name="kialo"
					maxlength="256"
					placeholder="Hasta 256 caracteres"
				/>
				<br />
				<br />
				<button class="butono butono-sendi" type="submit">Transferir fondos</button>
			</form>
		</main>
	</body>
</html>
