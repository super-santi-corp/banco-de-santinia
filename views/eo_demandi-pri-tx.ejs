<!DOCTYPE html>
<html lang="eo">
    <head>
        <title>Demandi pri transakcio - Banko de Santinio</title>
        <meta name="description" content="Demandi pri transakcio - Banko de Santinio" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/stil.css" />
    </head>
    <body>
        <h1>Demandi pri transakcio</h1>
        <main>
            <% if (tx === null && errorMessage !== '') { %>
                <span style="color: red"><%= errorMessage %></span>
            <% } else if (tx !== null) { %>
                <strong>
                    <%= tx.payer %> &rarr; <%= tx.payee %>
                    <% if (tx.status === 'approved') { %>
                        <span class="tx-stato tx-aprobita">APROBITA</span>
                    <% } else if (tx.status === 'declined') { %>
                        <span class="tx-stato tx-rifuzita">RIFUZITA</span>
                    <% } else if (tx.status === 'pending') { %>
                        <span class="tx-stato tx-atendanta">ATENDANTA</span>
                    <% } else { %>
                        <span class="tx-stato tx-nekonata">NEKONATA</span>
                    <% } %>
                </strong>
            <p>
            <strong>Transakcia identigilo:</strong> <code><%= tx.id %></code><br />
            <strong>Kvanto:</strong> <%= formatCurrency(tx.amount) %><br />
            <strong>Kialo:</strong> <%= tx.purpose %><br />
            <strong>Dato kaj tempo (GMT -5):</strong> <%= esperantoDate(new Date(tx.datetime), TIME_SHIFT) %>
            </p>
            <hr />
            <% } %>
        </main>
        <form action="/eo/demandi-pri-tx">
            <label for="txid">Transakcia identigilo: </label>
            <input type="text" id="txid" name="id" required />
            
            <br /><br />
            
            <button type="submit">Serĉi</button>
        </form>
    </body>
</html>