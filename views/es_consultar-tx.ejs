<!DOCTYPE html>
<html lang="es">
    <head>
        <title>Consultar transacción - Banco de Santinia</title>
        <link rel="stylesheet" href="/stil.css" />
    </head>
    <body>
        <h1>Consultar transacción</h1>
        <% if (tx === null && errorMessage !== '') { %>
            <span style="color: red"><%= errorMessage %></span>
        <% } else if (tx !== null) { %>
            <h4>
                <%= tx.payer %> &rarr; <%= tx.payee %>
                <% if (tx.status === 'approved') { %>
                    <span class="tx-stato tx-aprobita">APROBADA</span>
                <% } else if (tx.status === 'declined') { %>
                    <span class="tx-stato tx-rifuzita">RECHAZADA</span>
                <% } else if (tx.status === 'pending') { %>
                    <span class="tx-stato tx-atendanta">PENDIENTE</span>
                <% } else { %>
                    <span class="tx-stato tx-nekonata">DESCONOCIDA</span>
                <% } %>
            </h4>
        <p>
        <strong>Id. de transacción:</strong> <code><%= tx.id %></code><br />
        <strong>Monto:</strong> <%= formatCurrency(tx.amount) %><br />
        <strong>Por concepto de:</strong> <%= tx.purpose %><br />
        <strong>Fecha y hora:</strong> <%= spanishDate(new Date(tx.datetime)) %>
        </p>
        <hr />
        <% } %>
        <form action="/es/consultar-tx">
            <label for="txid">Id. de transacción: </label>
            <input type="text" id="txid" name="id" required />
            
            <br /><br />
            
            <button type="submit">Buscar</button>
        </form>
    </body>
</html>