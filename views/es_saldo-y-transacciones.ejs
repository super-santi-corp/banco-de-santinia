<!DOCTYPE html>
<html lang="es">
	<head>
		<title>Saldo y transacciones</title>
		<link rel="stylesheet" href="/stil.css" />
	</head>
	<body>
		<h1>Saldo y transacciones</h1>
		<p>Tu saldo es: <strong><%= balance %></strong></p>
		<details>
			<summary>Historial de transacciones (<%= transactions.length %>)</summary>
			<ul>
				<% transactions.forEach((tx) => { %>
					<li class="tx-detaloj">
						<strong><%= tx.sourceAccount %></strong> &rarr; <strong><%= tx.destinationAccount %></strong> <br />
						<strong>Monto: </strong>
						<span class="tx-kvanto <% if (tx.amount.startsWith('-')) { %>malpli-ol-nul<% } else {%>pli-ol-nul<% } %>">
							<%= tx.amount %>
						</span>
						<br />
						<strong>Fecha y hora: </strong>
						<%= spanishDate(new Date(tx.datetime)) %><br />
						<strong>Por concepto de: </strong>
						<%= tx.purpose %><br />
						<strong>Id. de transacción: </strong>
						<code><%= tx.txId %></code>
					</li>
				<% }); %>
			</ul>
		</details>
	</body>
</html>